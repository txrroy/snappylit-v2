{
  "expo": {
    "name": "snappylit-v2",
    "slug": "snappylit-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/snappylit-logo-v3.png",
    "scheme": "snappylit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/snappylit-logo-v3.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/snappylit-logo-v3.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/snappylit-logo-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/snappylit-logo-v3.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "02a1339d-e706-4088-8472-ed480d99310c"
      }
    }
  }
}

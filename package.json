{
  "name": "snappylit-v2",
  "version": "1.0.0",
  "workspaces": [
    "agent"
  ],
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npm run build:web && npm run build:agent",
    "build:web": "npx expo export --platform web",
    "build:agent": "npm --prefix agent run build",
    "emulators": "npx firebase emulators:start --project snappylit-news",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}

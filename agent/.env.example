# Gemini API Key (managed in Hostinger hPanel for production)
GEMINI_API_KEY=

# Firebase Admin credentials: either JSON string or path to service account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# For local development against Firebase Emulator Suite:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=snappylit-news

